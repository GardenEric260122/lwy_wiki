# 李文亚机器人配置模板
# 复制本文件为 .env（同目录），填入真实值。.env 已被 gitignore 忽略。
#
#   cp liwenya_bot/.env.example liwenya_bot/.env
#   然后用编辑器打开 .env 填入密钥（不要在命令行/对话里打密钥）

LIWENYA_BASE_URL=https://ai.aiclick.cc/v1
LIWENYA_API_KEY=在这里填你的密钥
LIWENYA_MODEL=在这里填模型名

# ---- Fandom Wiki 变更提醒（阶段 3，可选）----
# 接收通知的群号列表（JSON 数组），留空则不推送
FANDOM_NOTIFY_GROUPS=[]
# 轮询间隔（秒），默认 5 分钟
FANDOM_POLL_INTERVAL=300
