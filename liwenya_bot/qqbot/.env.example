# 李文亚 QQ 机器人 · NoneBot2 配置模板
# 复制为 .env（同目录）填真实值；.env 已被 gitignore 忽略。
#   cp .env.example .env

# ---- NoneBot2 / OneBot 连接 ----
# NapCat 用反向 WebSocket 连到这个地址；HOST 用 0.0.0.0 才能被 NapCat 连上
HOST=127.0.0.1
PORT=8080
# 与 NapCat 里配置的 token 一致（留空则不校验，仅本机自用可留空）
ONEBOT_ACCESS_TOKEN=

# 只响应这些 QQ 号的消息（超级用户，逗号分隔的 JSON 数组），可留空
SUPERUSERS=["你的QQ号"]
# 机器人的 QQ 昵称，用于命令前缀等
NICKNAME=["李文亚","李教授"]

# ---- 对话大脑（OpenAI 兼容中转 API，与命令行脚本共用同一套变量）----
LIWENYA_BASE_URL=https://ai.aiclick.cc/v1
LIWENYA_API_KEY=在这里填你的密钥
LIWENYA_MODEL=在这里填模型名

# ---- 行为参数 ----
# 每个会话（每群/每私聊）保留最近多少轮对话
LIWENYA_MAX_TURNS=12
# 同一会话两次触发之间的冷却秒数，防刷控成本
LIWENYA_COOLDOWN=3
# 采样温度，越高越"暴躁不羁"
LIWENYA_TEMPERATURE=0.9
# 单次回复最大 token
LIWENYA_MAX_TOKENS=250

# ---- Fandom Wiki 变更提醒（阶段 3，可选）----
# 接收通知的群号列表（JSON 数组），留空则不推送
FANDOM_NOTIFY_GROUPS=[]
# 轮询间隔（秒），默认 5 分钟
FANDOM_POLL_INTERVAL=300
# MediaWiki API 地址（一般不用改）
FANDOM_WIKI_API=https://wenyaverse.fandom.com/zh/api.php
# 推送是否带裸链接，默认 false（只报标题，不带链接）
# QQ 对短时间内连发外部链接风控敏感，同一域名连发多条容易触发限制/掉线，默认关闭更安全
FANDOM_INCLUDE_LINKS=false

# ---- B 站 UP 主视频提醒（可选）----
# 接收通知的群号列表（JSON 数组），留空则不推送
BILI_NOTIFY_GROUPS=[]
# 要监控的 UP 主 UID 列表（JSON 数组，支持多个）
BILI_UIDS=["178757758"]
# 兼容旧配置：单个 UID（BILI_UIDS 优先，两者都填时 BILI_UIDS 生效）
# BILI_UID=178757758
# 轮询间隔（秒），默认 5 分钟
BILI_POLL_INTERVAL=300
# B 站登录态 Cookie（强烈建议填，否则匿名请求大概率被 412 风控拦截）
# 获取方式：浏览器登录 B 站（建议用小号）→ F12 打开任意 bilibili.com 页面 →
# Network 面板随便点一个请求 → Request Headers 里复制完整 Cookie 值粘到这里。
# Cookie 一般几个月才失效一次，失效后重新复制即可，不需要频繁更新。
BILI_COOKIE=
